<resources>
    <string name="app_name">Джарвисджон</string>
    <string name="accessibility_service_description">Позволяет Джарвисджону делать снимки экрана во время разговора с голосовым помощником.</string>

    <!-- Setup Step 1: Gateway -->
    <string name="setup_step_1_of_4">Шаг 1 из 4</string>
    <string name="setup_gateway_title">Подключение к шлюзу</string>
    <string name="setup_gateway_description">Шлюз связывает приложение с локальным сервером Go на телефоне. Для проверки запросов между ними нужен ключ API.</string>
    <string name="setup_gateway_port_label">Порт</string>
    <string name="setup_gateway_port_hint">Локальный порт для связи с сервером (по умолчанию: 18790)</string>
    <string name="setup_gateway_api_key_label">Ключ API</string>
    <string name="setup_gateway_api_key_hint">Защищает связь приложения с сервером. Нажмите «Создать», чтобы получить ключ автоматически.</string>
    <string name="setup_generate_api_key">Создать ключ API</string>

    <!-- Setup Step 2: LLM -->
    <string name="setup_step_2_of_4">Шаг 2 из 4</string>
    <string name="setup_llm_title">Настройки ИИ-модели</string>
    <string name="setup_llm_description">Выберите ИИ-модель для помощника. Поддерживаются OpenAI, Anthropic и Gemini. Укажите название в формате поставщик/модель.</string>
    <string name="setup_llm_model_label">Модель</string>
    <string name="setup_llm_model_placeholder">поставщик/модель</string>
    <string name="setup_llm_model_hint">Формат: поставщик/модель (например, openai/gpt-5, anthropic/claude-sonnet-4-6, gemini/gemini-3.1-flash)</string>
    <string name="setup_llm_api_key_label">Ключ API</string>
    <string name="setup_llm_api_key_hint">Ключ API вашего поставщика ИИ-модели (OpenAI, Anthropic или Gemini)</string>
    <string name="setup_llm_base_url_label">Адрес API</string>
    <string name="setup_llm_base_url_hint">Свой адрес API. Оставьте поле пустым, чтобы использовать стандартный адрес поставщика.</string>
    <string name="setup_set_up_later">Настроить позже</string>

    <!-- Setup Step 3: Workspace -->
    <string name="setup_step_3_of_4">Шаг 3 из 4</string>
    <string name="setup_workspace_title">Рабочая папка и данные</string>
    <string name="setup_workspace_description">В рабочей папке помощник читает и сохраняет ваши файлы. В папке данных хранятся память помощника и журналы.</string>
    <string name="setup_workspace_label">Рабочая папка</string>
    <string name="setup_workspace_hint">Папка, в которой помощник читает и сохраняет файлы</string>
    <string name="setup_data_dir_label">Папка данных</string>
    <string name="setup_data_dir_hint">Папка для памяти помощника и журналов</string>

    <!-- Setup Step 4: Complete -->
    <string name="setup_step_4_of_4">Шаг 4 из 4</string>
    <string name="setup_complete_title">Настройка завершена!</string>
    <string name="setup_complete_description">Эти параметры можно изменить в настройках. Там же доступны настройка каналов и управление инструментами.</string>

